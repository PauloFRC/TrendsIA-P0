# Endpoint compatível com OpenAI
LLM_BASE_URL=https://api.openai.com/v1
# Nome do modelo no provedor
LLM_MODEL=

# required | none - se o endpoint exige credencial
LLM_AUTH=required
# Chave de API; preencha somente no .env
LLM_API_KEY=

# local | external - se o diff sai desta máquina
LLM_DATA_EGRESS=external

# Timeouts em segundos
LLM_TIMEOUT_CONNECT=5
LLM_TIMEOUT_READ=120

LLM_TEMPERATURE=0
LLM_SEED=42

# Limite de tamanho do diff, em caracteres
LLM_MAX_INPUT_CHARS=60000
LLM_MAX_OUTPUT_TOKENS=1024
